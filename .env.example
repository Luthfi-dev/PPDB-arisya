# ==============================================================================
# KONFIGURASI LINGKUNGAN SERVER NODE.JS — PPDB YAYASAN AR-RISALAH ACEH
# Salin file ini menjadi ".env" pada server hosting Anda dan isi nilainya.
# JANGAN PERNAH mengunggah file ".env" asli ke repository Git publik.
# ==============================================================================

# 1. Mode Aplikasi, Server Runtime & Networking (cPanel Node.js / VPS PM2 / Railway / Render / Cloud Run)
# APP_MODE: "development" (melonggarkan rate-limit, HSTS, dan CORS dev agar tidak terblokir saat pengujian)
#           atau "production" (menerapkan seluruh proteksi keamanan produksi secara ketat)
APP_MODE="production"
NODE_ENV="production"
PORT="3000"
HOST="0.0.0.0"
# TRUST_PROXY: "1" jika di belakang Nginx / Apache / Cloudflare / Cloud Run reverse proxy, "0" jika langsung
TRUST_PROXY="1"

# 2. Domain Aplikasi & CORS Allowlist
# Isi dengan URL publik lengkap domain PPDB Anda tanpa garis miring di akhir
APP_URL="https://ppdb.sekolahanda.sch.id"
# Pisahkan dengan koma jika ada lebih dari satu origin (misal domain utama + www).
# Isi "*" untuk mengizinkan akses CORS lintas-domain publik dari semua domain (tanpa credentials wildcard).
ALLOWED_ORIGINS="https://ppdb.sekolahanda.sch.id"

# 3. Keamanan Cookie Sesi HttpOnly & CSRF
# Pilihan: "lax" (DIREKOMENDASIKAN untuk hosting domain sendiri / production),
#          "strict" (sangat ketat, memblokir cookie dari klik link eksternal),
#          "none" (khusus iframe lintas domain HTTPS; wajib HTTPS)
COOKIE_SAMESITE="lax"
# Wajib false di produksi!
ENABLE_DEMO_LOGIN="false"

# 4. Kunci Kriptografi Server (WAJIB DIGANTI — gunakan 64 karakter hex acak via: openssl rand -hex 32)
SESSION_SECRET="CHANGE_ME_STRONG_RANDOM_SESSION_SECRET_64_HEX"
APP_ENCRYPTION_KEY="CHANGE_ME_STRONG_RANDOM_ENCRYPTION_KEY_64_HEX"

# 5. Konfigurasi Database MySQL (phpMyAdmin, cPanel, atau VPS)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="ppdb_arrisalah"

# 6. PIN Keamanan Real Database Explorer (Bcrypt hash — default contoh untuk PIN 8 digit)
REAL_DB_PIN_HASH='$2b$10$7Ncfg3UJPaoAJhivL.sOfuJBYoatekgSYV3A.MmUWXKMkwSz6ar16'

# 7. Keamanan Cloudflare Turnstile (Dikelola 100% melalui .env server demi keamanan)
# Set "true" untuk mengaktifkan proteksi Cloudflare Turnstile, atau "false" untuk menonaktifkannya.
CLOUDFLARE_ENABLED="false"
CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# 8. Opsional: Gemini API Key (jika menggunakan fitur AI di server)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
